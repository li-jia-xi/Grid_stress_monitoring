# Azure Data Lake Storage Gen2 (Bronze / Silver / Gold containers)
ADLS_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<your-account>;AccountKey=<your-key>;EndpointSuffix=core.windows.net

# Optional: Azure Event Hub (feeds Stream Analytics -> Power BI live dashboard)
EVENTHUB_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<policy>;SharedAccessKey=<key>
EVENTHUB_NAME=iso-ne-stream

# Optional: local copy of the Gold feature table (a .parquet file or a folder of part files).
# If set, the modeling notebook reads it instead of ADLS.
# GOLD_LOCAL_PATH=data/demand_features.parquet
